#!/bin/bash
# Termux Downloader — URL opener (hacker-style).
# Share any URL to Termux -> this runs with the URL as $1.
# Install: copy to ~/bin/termux-url-opener, then chmod +x ~/bin/termux-url-opener

if [ -z "$1" ]; then
    echo -e "\033[91m[✗] Error: No URL found.\033[0m"
    exit 1
fi

GREEN="\033[92m"; CYAN="\033[96m"; RED="\033[91m"
YELLOW="\033[93m"; MAGENTA="\033[95m"; BOLD="\033[1m"
DIM="\033[2m"; RESET="\033[0m"

clear
echo -e "${GREEN}${BOLD}"
cat << 'EOF'
████  █████       █████ █████ ████  █   █ █   █ █   █
█   █    █          █   █     █   █ ██ ██ █   █  █ █
█   █   █   █████   █   ████  ████  █ █ █ █   █   █
█   █  █            █   █     █ █   █   █ █   █  █ █
████  █████         █   █████ █  █  █   █  ███  █   █
EOF
echo -e "${RESET}"
echo -e "${CYAN}${BOLD}  [+] DZ-TERMUX DOWNLOADER // URL OPENER${RESET}"
echo -e "${DIM}  [~] video | file | audio | ytdl${RESET}"
echo -e "${MAGENTA}  ============================================${RESET}"
echo -e "  Link: ${CYAN}$1${RESET}"
echo ""

# tiny boot animation (cosmetic, ~0.5s)
for f in '|' '/' '-' '\'; do printf "\r  ${YELLOW}[~] Loading modules... %s${RESET}" "$f"; sleep 0.12; done
printf "\r  ${GREEN}[+] Modules loaded.                      ${RESET}\n\n"

echo -e "${CYAN}Select Download Option:${RESET}"
echo -e "  ${GREEN}[1]${RESET} 🎬 Video (Best Quality - Up to 4K)"
echo -e "  ${GREEN}[2]${RESET} 📦 File / Zip (aria2)"
echo -e "  ${GREEN}[3]${RESET} 🎵 Audio (MP3)"
echo -e "  ${GREEN}[4]${RESET} 🐍 ytdl (choose quality + cookies)"
echo -e "  ${GREEN}[q]${RESET} 🚪 Quit"
echo -e "${MAGENTA}============================================${RESET}"
read -p "$(echo -e "${CYAN}Enter number 1, 2, 3, 4, or q: ${RESET}")" choice

if [ "$choice" = "1" ]; then
    echo -e "${GREEN}[>] Downloading video in best available quality...${RESET}"
    # 4K / Best quality selection
    yt-dlp -N 10 --downloader aria2c --downloader-args aria2c:"-x 16 -s 16 -k 1M" \
        -f "bestvideo+bestaudio/best" --merge-output-format mp4 \
        -P "$HOME/storage/shared/Movies/" "$1"

elif [ "$choice" = "2" ]; then
    echo -e "${GREEN}[>] Downloading file via aria2...${RESET}"
    aria2c -x 16 -s 16 -k 1M -d "$HOME/storage/shared/Download/Files" "$1"

elif [ "$choice" = "3" ]; then
    echo -e "${GREEN}[>] Downloading audio as MP3...${RESET}"
    yt-dlp -x --audio-format mp3 --audio-quality 0 \
        -P "$HOME/storage/shared/Download/Music" "$1"

elif [ "$choice" = "4" ]; then
    if [ ! -f "$HOME/ytdl.py" ]; then
        echo -e "${RED}[✗] ytdl.py not found in home folder.${RESET}"
        echo -e "${YELLOW}    Put ytdl.py in Termux home (~) and try again.${RESET}"
        exit 1
    fi
    echo -e "${GREEN}[>] Launching ytdl module...${RESET}"
    python "$HOME/ytdl.py" "$1"

elif [ "$choice" = "q" ]; then
    echo -e "${DIM}Bye.${RESET}"
    exit 0

else
    echo -e "${RED}[✗] Invalid selection. Exiting.${RESET}"
    exit 1
fi

echo -e "${MAGENTA}============================================${RESET}"
echo -e "${GREEN}[+] Download finished successfully!${RESET}"
echo -e "Check your device's Download folder."
echo -e "${MAGENTA}============================================${RESET}"
